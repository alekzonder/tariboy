---
import PageLayout from "blume/components/layout/PageLayout.astro";
import BlumePage from "blume/components/BlumePage.astro";
import data from "blume:data";

const { config } = data;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: "Tariboy — From one agent to a team",
    description: "Define reusable images, run coding agents interactively, and grow into autonomous teams.",
    route: "/",
  }}
>
  <div class="home">
    <BlumePage id="index.mdx" />
  </div>
</PageLayout>

<style>
  .home {
    max-width: 1120px;
    margin-inline: auto;
    padding: 0 24px 64px;
    line-height: 1.65;
  }
  .home :global(h1),
  .home :global(h2) {
    font-family: var(--blume-font-display);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .home :global(h1) { font-size: clamp(3.5rem, 7vw, 6rem); margin: 24px 0; }
  .home :global(h2) { font-size: 2rem; margin: 12px 0 20px; }
  .home :global(p) { margin-block: 0 20px; }
  .home :global(a) { text-underline-offset: 4px; }
  .home :global(a:focus-visible) { outline: 2px solid var(--blume-accent); outline-offset: 5px; }
  .home :global(section[id]) { scroll-margin-top: 96px; }
  .home :global(.eyebrow) {
    color: var(--blume-muted-foreground);
    font: 0.75rem/1.5 var(--blume-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .home :global(.hero) { padding: 80px 0 48px; }
  .home :global(.hero-description) { max-width: 680px; font-size: 1.25rem; color: var(--blume-muted-foreground); }
  .home :global(.actions) { display: flex; flex-wrap: wrap; gap: 12px; margin: 32px 0 24px; }
  .home :global(.actions p) { margin: 0; }
  .home :global(.actions a) { display: inline-block; padding: 12px 20px; border: 1px solid var(--blume-border); border-radius: var(--blume-radius); font-weight: 600; }
  .home :global(.primary-action a) { color: var(--blume-background); background: var(--blume-foreground); }
  .home :global(.actions a:hover) { text-decoration: underline; }
  .home :global(.alpha-note) { color: var(--blume-muted-foreground); font-size: 0.8rem; }
  .home :global(.progression) {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    padding: 28px 0 40px;
    border-block: 1px solid var(--blume-border);
  }
  .home :global(.progression a) { display: flex; flex-direction: column; gap: 8px; }
  .home :global(.progression a:hover strong) { text-decoration: underline; }
  .home :global(.progression a > span:last-child) { font-size: 0.8rem; color: var(--blume-muted-foreground); }
  .home :global(.step-number) { font: 0.75rem var(--blume-font-mono); color: var(--blume-accent); }
  .home :global(.feature),
  .home :global(.start-panel) { display: grid; grid-template-columns: 1fr 1.7fr; gap: 64px; padding: 56px 0; border-bottom: 1px solid var(--blume-border); }
  .home :global(.feature-summary) { color: var(--blume-muted-foreground); }
  .home :global(.feature-detail a),
  .home :global(.start-panel a),
  .home :global(.explore > p a) { color: var(--blume-accent); text-decoration: underline; }
  .home :global(.feature-detail code) { font: 0.9em var(--blume-font-mono); background: var(--blume-muted); padding: 2px 5px; border-radius: 4px; }
  .home :global(.start-panel) { margin-top: 32px; padding: 32px; border: 1px solid var(--blume-border); border-radius: var(--blume-radius); background: var(--blume-muted); }
  .home :global(.explore) { padding-top: 64px; }
  @media (max-width: 700px) {
    .home { padding-inline: 20px; }
    .home :global(.hero) { padding-top: 48px; }
    .home :global(.progression) { grid-template-columns: 1fr 1fr; gap: 24px; }
    .home :global(.feature),
    .home :global(.start-panel) { grid-template-columns: 1fr; gap: 12px; padding-block: 32px; }
    .home :global(.start-panel) { padding-inline: 20px; }
  }
</style>
