  "workflow.inspect rich": {
    "built_at": "$VOLATILE",
    "definition": {
      "artifacts": [
        {
          "description": "The implementation plan, as Markdown.",
          "name": "plan"
        },
        {
          "name": "pull_request"
        }
      ],
      "env": {
        "PR_POLL_SECONDS": "60"
      },
      "initial_status": "plan",
      "limits": {
        "idle_iterations": 3,
        "rejected_requests": 5,
        "script_failures": 3,
        "unavailable_grace": "5m"
      },
      "name": "rich",
      "requires_secrets": [
        "GH_TOKEN"
      ],
      "schema_version": 1,
      "sources": [
        {
          "description": "Lists the open pull requests.",
          "every": "2m",
          "name": "incoming",
          "script": "./scripts/incoming.sh",
          "timeout": "30s"
        }
      ],
      "statuses": [
        {
          "id": "plan",
          "instructions": "./statuses/plan.md",
          "limits": {
            "idle_iterations": 6
          },
          "owner": {
            "kind": "pool",
            "pool": "developers"
          },
          "transitions": [
            {
              "checks": [
                {
                  "description": "The plan exists.",
                  "run_as": "agent",
                  "script": "./scripts/check.sh",
                  "timeout": "60s"
                }
              ],
              "on": "planned",
              "requires": [
                "plan"
              ],
              "to": "approval"
            }
          ]
        },
        {
          "id": "approval",
          "owner": {
            "kind": "customer"
          },
          "transitions": [
            {
              "on": "approved",
              "to": "review"
            },
            {
              "on": "rejected",
              "to": "cancelled"
            }
          ]
        },
        {
          "id": "review",
          "owner": {
            "kind": "script"
          },
          "transitions": [
            {
              "on": "merged",
              "to": "done"
            }
          ],
          "watch": {
            "description": "Watches the pull request.",
            "every": "60s",
            "script": "./scripts/monitor.sh",
            "timeout": "60s"
          }
        },
        {
          "id": "done",
          "owner": {
            "kind": ""
          },
          "terminal": true
        },
        {
          "cancelled": true,
          "id": "cancelled",
          "owner": {
            "kind": ""
          },
          "terminal": true
        }
      ],
      "watch_spacing": "30s",
      "workflow_version": "0.1.0"
    },
