{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tariboy",
  "version": "0.46.2",
  "identifier": "app.tariboy.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../ui && npm run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tariboy",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 15
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/": ""
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
