bin/
.logs/
*.test
*.log
__pycache__/
node_modules
.vscode

# Local agent/tooling scratch — not part of the project
.agents/
.claude/
.serena/
.superpowers/
.worktrees/
.tariboy
/tariboy
/tariboyd
/tariboy-shim
/tariboy-store

# Built-in basic image bundle: generated by `make build-basic-image` before
# tariboyd is compiled. The canonical source is internal/builtinimages/source.
internal/builtinimages/generated/*
!internal/builtinimages/generated/.gitkeep

# Legacy built-in team template output is uncommitted build state.
internal/builtingroups/generated/*
!internal/builtingroups/generated/.gitkeep

# Desktop app build artifacts. desktop/dist is the Vite output consumed by
# `cargo tauri build` (never committed — `make desktop` always rebuilds it), and
# resources/bin is filled with Darwin arm64 and Linux x86_64 payloads by the
# same target.
desktop/dist/
ui/dist/
ui/.cache/
ui/.eslintcache
desktop/src-tauri/target/
ui/test-results/
ui/test-results-desktop/
# `gen/schemas` is regenerated by tauri-build on every compile (it is what the
# capability files' $schema points at), so it is an artifact, not source.
desktop/src-tauri/gen/schemas/
# The `bin/` rule on line 1 matches a directory named `bin` at ANY depth, and git
# never descends into an excluded directory — so without re-including the
# directory first, the `.gitkeep` negation below could never fire.
!desktop/src-tauri/resources/bin/
desktop/src-tauri/resources/bin/*
!desktop/src-tauri/resources/bin/.gitkeep

# Locally generated, signed alpha release directories. Publication is a manual
# reviewed action; DMGs and release checksums are never source-controlled.
dist/releases/
.DS_Store
