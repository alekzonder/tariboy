{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["tests/**/*.{ts,tsx,mjs}", ".design-sync/**/*.{ts,tsx,mjs}"],
  "project": [
    "src/**/*.{ts,tsx,css}!",
    "store/**/*.{ts,tsx,css}!",
    "!src/test/**!",
    "tests/**/*.{ts,tsx,mjs}",
    ".design-sync/**/*.{ts,tsx,mjs}"
  ],
  "playwright": { "config": ["playwright.*.config.ts"] },
  "vite": { "config": ["vite*.config.ts"] },
  "ignoreBinaries": ["go"],
  "ignoreIssues": {
    "src/components/ui/*.tsx": ["exports"],
    "src/components/ui/separator.tsx": ["files"],
    "src/components/ui/tooltip.tsx": ["files"]
  }
}
